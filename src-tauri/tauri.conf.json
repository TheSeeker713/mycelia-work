{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mycelia Time",
  "version": "0.1.0",
  "identifier": "com.myceliainteractive.time",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mycelia Time",
        "width": 480,
        "height": 680,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "publisher": "Mycelia Interactive LLC",
    "shortDescription": "Local time tracking with an AI work journal",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBQ0MzRUJDMEE3Mjk1QzIKUldUQ2xYSUt2RDdNZWoxTnVEMXMzWGgveHpjdWFaaUp6dXozdkp1ajh1eW9VRS8wN3liL3VKWUMK",
      "endpoints": [
        "https://updates.myceliainteractive.com/mycelia-time/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
